1st solution:
use sql_STORE;

select p.name, sum(oi.quantity*oi.unit_price) as total_revenue
from products p
join order_items oi using (product_id)
group by p.name 
order by total_revenue desc

2nd solution:
use sql_STORE;

select p.name, 
(select sum(oi.quantity*oi.unit_price) from order_items oi
where p.product_id=oi.product_id) as total_revenue 
from products p
order by  total_revenue  desc
