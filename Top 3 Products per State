with revenue_TT as (
SELECT
        c.state,
        p.name AS product_name,
        SUM(oi.quantity * oi.unit_price) AS total_revenue
    FROM customers c
    JOIN orders o ON c.customer_id = o.customer_id
    JOIN order_items oi ON o.order_id = oi.order_id
    JOIN products p ON oi.product_id = p.product_id
    GROUP BY c.state, p.product_id, p.name),
  product_rank as
    (
    select
    state,
         product_name,
         total_revenue,
    rank() over(partition by state order by total_revenue desc) as rank_R
    from revenue_TT
    )
    select
     state,
         product_name,
         total_revenue,
         rank_r
         from product_rank
         where  rank_r<=3
